---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoAuftritt from '../components/LogoAuftritt.astro';
import RessortGrid from '../components/RessortGrid.astro';
import RealityCheckCard from '../components/RealityCheckCard.astro';
import ExampleNotice from '../components/ExampleNotice.astro';
import UpdateTicker from '../components/UpdateTicker.astro';
import { title } from '../lib/magazin';
const [ressorts, projekte, firmen, artikel, updates] = await Promise.all([
  getCollection('ressorts'), getCollection('projekte'), getCollection('firmen'), getCollection('artikel'), getCollection('updates'),
]);
const latestUpdates = updates.toSorted((a, b) => b.data.datum.localeCompare(a.data.datum));
---
<BaseLayout title="Serienreif oder nur versprochen?">
  <LogoAuftritt />
  <ExampleNotice beispiel={projekte.some(({ data }) => data.beispiel)} />
  <section class="section" id="forschungsfelder"><div class="in">
    <div class="section-head"><h2 class="heading">Forschungsfelder</h2><p class="tag">Technik verstehen. Versprechen prüfen.</p></div>
    <RessortGrid ressorts={ressorts} projekte={projekte} />
  </div></section>
  <UpdateTicker updates={latestUpdates} />
  <section class="section" id="checks"><div class="in">
    <div class="section-head"><h2 class="heading">Reality Checks</h2><p class="note">Jedes Projekt wird einzeln bewertet. Voll ist belegt, orange schraffiert ist behauptet.</p></div>
    <div class="cards">{projekte.map(({ data: p }) => <RealityCheckCard projekt={p} firma={firmen.find(({ data }) => data.slug === p.firma)!.data.name} ressort={ressorts.find(({ data }) => data.slug === p.ressorts[0])!.data.name} />)}</div>
  </div></section>
  <section class="section"><div class="in">
    <div class="section-head"><h2 class="heading">Unter der Oberfläche</h2><span class="tag">Erklärstücke</span></div>
    <ul class="article-list">{artikel.toSorted((a, b) => b.data.datum.localeCompare(a.data.datum)).map(({ data: a }) => <li><a href={`/artikel/${a.slug}/`}><span class="tag">{a.beispiel ? 'Beispiel · frei erfunden' : a.typ}</span><h3>{title(a.titel)} <span aria-hidden="true">↗</span></h3><p class="note">{a.zusammenfassung}</p></a></li>)}</ul>
  </div></section>
</BaseLayout>

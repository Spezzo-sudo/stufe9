---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MagazineCover from '../../components/MagazineCover.astro';
import ausgabe from '../../content/entwurf/magazin.json';
import { getCollection } from 'astro:content';
const projekte = await getCollection('projekte');
const geschichten = ausgabe.geschichten.map(g => ({ ...g, projekt: projekte.find(p => p.data.slug === g.projekt)!.data }));
---
<BaseLayout title="Die Zukunft auf dem Prüfstand – Magazin-Entwurf" navigationBase="/entwurf/" fieldsAnchor="themen" checksAnchor="geschichten">
  <div class="in magazine">
    <MagazineCover />
    <section class="stories" id="geschichten" aria-labelledby="stories-heading">
      <div class="section-label"><h2 id="stories-heading">Aus der Redaktion</h2><span class="tag">Zwei Reality Checks · frei erfundene Beispiele</span></div>
      <div class="story-grid">{geschichten.map((g, i) => <article class:list={['story', { main: i === 0 }]}>
        <p class="tag">{ausgabe.felder.find(f => f.slug === g.projekt.ressorts[0])?.name} · Beispiel</p>
        <h3><a href={`/projekt/${g.projekt.slug}/`}>{g.titel}</a></h3><p>{g.einstieg}</p>
        <a class="text-link" href={`/projekt/${g.projekt.slug}/`}>Zum Reality Check <span aria-hidden="true">→</span></a>
      </article>)}</div>
    </section>
    <section class="purpose"><h2>Versprochen.<br />Gezeigt. Geprüft.</h2><div><p>Eine Vorführung macht noch kein fertiges Produkt. Unsere Reality Checks ordnen einzelne Projekte ein: Was verspricht die Firma? Was ist belegt? Und was fehlt noch?</p><p class="small">Diese Entwurfsausgabe enthält erfundene Beispielprojekte. Weitere Ressorts sind als in Vorbereitung gekennzeichnet.</p></div></section>
    <p class="compare"><a href="/">Bisherige Startseite ansehen ↗</a></p>
  </div>
</BaseLayout>
<style>
  .magazine { padding-bottom: 32px; }
  .stories { padding-block: 32px 40px; }
  .section-label { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 26px; }
  h2 { font: 600 28px/1 var(--display); text-transform: uppercase; }
  .section-label .tag { font-size: 8px; color: var(--muted); }
  .story-grid { display: grid; gap: 28px; }
  .story > .tag { color: var(--muted); font-size: 9px; }
  h3 { font: 600 34px/1.05 var(--display); margin-block: 12px; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .story > p:not(.tag) { max-width: 54ch; font-size: 16px; line-height: 1.6; }
  .story .text-link { display: inline-block; margin-top: 16px; padding-block: 6px; font-size: 10px; }
  .story + .story { border-top: 1px solid var(--paper-line); padding-top: 26px; }
  .purpose { border-block: 1px solid var(--ink-2); padding-block: 28px; display: grid; gap: 20px; }
  .purpose h2 { font-size: 36px; line-height: 1.05; }
  .purpose p { max-width: 60ch; }
  .small { color: var(--muted); font-size: 12px; margin-top: 14px; }
  .compare { padding-top: 24px; font-size: 12px; color: var(--muted); }
  @media (min-width: 760px) { .stories { padding-block: 44px; } .story-grid { grid-template-columns: 1.45fr 1fr; gap: 48px; } .main h3 { font-size: 46px; } .story + .story { padding-top: 0; border-top: 0; border-left: 1px solid var(--paper-line); padding-left: 36px; } .purpose { grid-template-columns: 1fr 1.4fr; gap: 48px; } }
</style>

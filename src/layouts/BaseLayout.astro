---
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ScrollHint from '../components/ScrollHint.astro';

interface Props { title: string; description?: string; navigationBase?: string; fieldsAnchor?: string; checksAnchor?: string; }
const { title, navigationBase = '/', fieldsAnchor = 'forschungsfelder', checksAnchor = 'checks', description = 'Frontier-Tech im Reality Check. Serienreif oder nur versprochen?' } = Astro.props;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Stufe 9</title>
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="top">
      <div class="in">
        <Logo />
        <nav aria-label="Hauptnavigation"><a href={`${navigationBase}#${fieldsAnchor}`}>Felder</a><a href={`${navigationBase}#${checksAnchor}`}>Reality Checks</a></nav>
      </div>
    </header>
    <main id="inhalt" tabindex="-1"><slot /></main>
    <footer class="dark"><div class="in"><div><b>STUFE 9</b><p>Serienreif oder nur versprochen?</p><p>Diese Ausgabe enthält frei erfundene Beispieldaten. Jeder Beispieleintrag ist gekennzeichnet.</p></div><nav aria-label="Weitere Seiten"><a href="/?auftritt=1">Auftritt ansehen</a><a href="/updates/">Updates</a><a href="/beispiele/">Beispieldaten</a><a href="/prototypes/">Design-Referenzen</a></nav></div></footer>
    <ScrollHint />
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('.top');
  if (header) new ResizeObserver(() => {
    document.documentElement.style.setProperty('--header-height', `${header.getBoundingClientRect().height + Number.parseFloat(getComputedStyle(header).top || '0')}px`);
  }).observe(header);
</script>

<style>
  .top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 9; background: var(--ink); color: var(--on-ink); border-bottom: 1px solid var(--ink-line); }
  .top .in { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 12px; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 18px; font: 500 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  nav a { color: var(--on-ink-muted); text-decoration: none; padding-block: 6px; }
  nav a:hover { color: var(--signal); }
  footer .in { padding-block: 22px 40px; color: var(--on-ink-muted); font-size: 14px; }
  footer { border-top: 1px solid var(--ink-line); }
  footer b { display: block; color: var(--on-ink); font: 700 28px/1 var(--display); letter-spacing: .07em; margin-bottom: 12px; }
  footer p + p { margin-top: 8px; max-width: 60ch; font-size: 12px; }
  footer nav { justify-content: flex-start; gap: 18px; margin-top: 24px; }
  @media (max-width: 400px) { .top .in { gap: 10px; } .top nav { gap: 8px; font-size: 10px; } }
</style>

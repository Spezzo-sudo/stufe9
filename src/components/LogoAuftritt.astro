---
// Der grosse Auftritt der Startseite: Die Forschungsfelder stehen als Punktwolken um das Logo
// und fliessen in die neun Segmente. Er ist nur sichtbar, wenn html die Klasse «intro» trägt (erster Besuch, siehe index.astro).
interface Props { felder: { name: string; motiv: string }[]; }
const { felder } = Astro.props;
---
<section class="hero dark" id="hero" aria-label="Stufe 9" data-felder={JSON.stringify(felder)}>
  <canvas id="icv" aria-hidden="true"></canvas>
  <button class="lock" id="lock" type="button" aria-label="Stufe 9 – Auftritt erneut abspielen">
    <span class="ph" id="ph" aria-hidden="true">{Array.from({ length: 9 }, () => <i />)}</span><b>STUFE 9</b>
  </button>
  <div class="copy"><p class="claim">Serienreif oder nur <em>versprochen?</em></p><p class="tag">Frontier-Tech im Reality Check</p></div>
  <a class="explore tag" href="#aufmacher">Zur Ausgabe <span aria-hidden="true">↓</span></a>
</section>
<script>
  import { initAuftritt } from '../motive/auftritt.js';
  initAuftritt();
</script>
<style>
  .hero { display: none; }
  :global(html.intro) .hero { display: flex; }
  .hero { position: relative; height: calc(82svh - var(--header-height, 56px)); min-height: 420px; max-height: 660px; overflow: hidden; flex-direction: column; align-items: center; justify-content: center; gap: clamp(20px, 4vw, 36px); padding: 16px 16px 40px;
    background-image: linear-gradient(var(--ink-2) 1px, transparent 1px), linear-gradient(90deg, var(--ink-2) 1px, transparent 1px); background-size: 32px 32px; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; visibility: hidden; }
  .hero.canvas-ready canvas { visibility: visible; }
  .lock { all: unset; cursor: pointer; display: inline-flex; align-items: flex-end; gap: .4em; font-size: clamp(34px, 9.2vw, 100px); -webkit-tap-highlight-color: transparent; }
  .lock:focus-visible { outline: 2px solid var(--signal); outline-offset: 8px; }
  .lock b { font: 700 1.08em/.72 var(--display); letter-spacing: .07em; white-space: nowrap; }
  .ph { display: inline-flex; align-items: flex-end; gap: var(--logo-segment-gap); width: 2.21em; height: 1em; }
  .ph i { width: var(--logo-segment-width); height: var(--logo-segment-height); background: var(--on-ink); }
  .ph i:last-child { height: 1em; background: var(--signal); }
  .canvas-ready .ph i { visibility: hidden; }
  .copy { display: grid; gap: 12px; text-align: center; position: relative; }
  .claim { font: 700 clamp(28px, 5vw, 52px)/.95 var(--display); text-transform: uppercase; max-width: 24ch; }
  em { color: var(--signal); font-style: normal; }
  .copy .tag { color: var(--on-ink-muted); }
  .canvas-ready.pre .copy, .canvas-ready.pre .explore { opacity: 0; }
  .copy, .explore { transition: opacity .5s ease-out; }
  .explore { position: absolute; bottom: 14px; color: var(--on-ink-muted); text-decoration: none; padding-block: 10px; }
  .explore span { margin-left: 10px; color: var(--signal); }
  @media (max-height: 500px) and (orientation: landscape) { .hero { height: auto; min-height: 300px; padding-block: 36px 60px; gap: 20px; } .lock { font-size: 46px; } .claim { font-size: 32px; } }
  @media (prefers-reduced-motion: reduce) { canvas { display: none; } .canvas-ready .ph i { visibility: visible; } .canvas-ready.pre .copy, .canvas-ready.pre .explore { opacity: 1; transition: none; } }
</style>

<a class="logo" href="/" aria-label="Stufe 9, zur Startseite">
  <span class:list={['mark', { sweep: Astro.url.pathname !== '/' }]} aria-hidden="true">{Array.from({ length: 9 }, (_, i) => <i style={`--i:${i}`} />)}</span>
  <b aria-hidden="true">STUFE 9</b>
</a>

<style>
  .logo { display: inline-flex; align-items: flex-end; gap: .4em; font-size: 22px; color: inherit; text-decoration: none; flex-shrink: 0; }
  .logo b { font: 700 1.08em/.72 var(--display); letter-spacing: .07em; white-space: nowrap; }
  .mark { display: inline-flex; align-items: flex-end; gap: var(--logo-segment-gap); height: 1em; }

---
import ausgabe from '../content/entwurf/magazin.json';
import { titelwelt } from '../motive/titelwelt';
const gruppen = titelwelt();
const primary = ausgabe.felder.filter((f) => f.motiv);
---
<section class="cover" aria-labelledby="cover-title">
  <div class="cover-top tag"><span>Frontier-Tech im Reality Check</span><span>Magazin-Entwurf</span></div>
  <div class="cover-layout">
    <div class="cover-copy"><h1 id="cover-title">{ausgabe.titel}</h1><p>{ausgabe.intro}</p><a class="stories-link text-link" href="#geschichten">Die Geschichten lesen <span aria-hidden="true">↓</span></a></div>
    <div class="cover-world" id="themen">
      <div class="atlas">
        <svg viewBox="0 0 600 510" aria-hidden="true" focusable="false">{Object.entries(gruppen).map(([name, points]) => <g class={`drawing drawing-${name}`}>{points.map(p => <circle cx={p.x} cy={p.y} r={p.r} opacity={p.o} />)}</g>)}</svg>
        <nav aria-label="Forschungsfelder im Titelbild">{primary.map((f,i) => <a class={`area area-${i}`} href={f.href}><span class="field-name">{f.name} <span aria-hidden="true">↗</span></span><span class="field-description">{f.thema}</span><span class="field-status">{f.status === 'geplant' ? 'In Vorbereitung' : 'Mit Beispielprojekt'}</span></a>)}</nav>
      </div>
      <p class="map-caption tag">Ein Bild. Vier Einstiege. <span>Schematische Illustration</span></p>
    </div>
  </div>
  <nav class="all-fields" aria-label="Alle Forschungsfelder"><span class="tag">Themen</span>{ausgabe.felder.map(f => <a href={f.href}>{f.name}</a>)}</nav>
</section>
<style>
  .cover { border-bottom: 1px solid var(--ink-2); }
  .cover-top { display: flex; justify-content: space-between; gap: 16px; padding-block: 20px 16px; border-bottom: 1px solid var(--ink-2); color: var(--muted); font-size: 9px; letter-spacing: .06em; }
  .cover-layout { padding-top: 32px; }
  h1 { font: 700 clamp(48px, 8vw, 88px)/.94 var(--display); text-transform: uppercase; letter-spacing: -.025em; max-width: 15ch; }
  h1 em { font-style: normal; }
  .cover-copy > p { margin-top: 22px; max-width: 42ch; font-size: 16px; line-height: 1.6; color: var(--muted); }
  .stories-link { display: inline-block; margin-top: 14px; padding-block: 8px; font-size: 10px; }
  .stories-link span { margin-left: 14px; }
  .cover-world { min-width: 0; }
  .atlas { position: relative; margin-top: 24px; padding-block: 32px; }
  svg { display: block; width: 100%; height: auto; fill: var(--ink-2); }
  .area { position: absolute; width: 50%; height: 50%; display: flex; flex-direction: column; text-decoration: none; padding: 4px 0; }
  .area-0 { top: 0; left: 0; }
  .area-1 { top: 0; right: 0; text-align: right; }
  .area-2 { bottom: 0; left: 0; justify-content: flex-end; }
  .area-3 { bottom: 0; right: 0; text-align: right; justify-content: flex-end; }
  .field-name { font: 600 clamp(20px, 3vw, 28px)/1.1 var(--display); text-transform: uppercase; }
  .field-name > span { font: 400 16px/1 var(--body); }
  .field-description { font-size: 10px; line-height: 1.5; }
  .field-status { font: 400 8px/1.7 var(--mono); color: var(--muted); }
  .area:hover .field-name, .area:focus-visible .field-name { text-decoration: underline; text-underline-offset: 4px; }
  .area:focus-visible { outline-offset: 0; }
  .map-caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; margin-top: 16px; font-size: 8px; color: var(--muted); letter-spacing: .03em; }
  .all-fields { margin-top: 28px; padding-block: 18px; border-top: 1px solid var(--paper-line); display: flex; flex-wrap: wrap; gap: 4px 18px; align-items: center; }
  .all-fields > .tag { color: var(--muted); width: 100%; margin-bottom: 6px; font-size: 9px; }
  .all-fields a { font-size: 13px; padding-block: 7px; text-decoration: none; }
  .all-fields a:hover { text-decoration: underline; }
  @media (min-width: 800px) { .cover-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 30px; align-items: center; padding-block: 32px 12px; } h1 { font-size: clamp(60px, 6.5vw, 82px); } .atlas { margin-top: 0; } .cover-top { font-size: 10px; } .all-fields > .tag { width: auto; margin: 0 8px 0 0; } }
  @media (max-width: 360px) { .cover-top { font-size: 8px; } h1 { font-size: 44px; } .field-name { font-size: 18px; } .field-description { font-size: 9px; } }
</style>

---
// Der orange Streifen: was sich bewegt hat. Stufenwechsel und verschobene Termine stehen als Marke vor dem Titel.
import type { CollectionEntry } from 'astro:content';
import { title, datum, bewegung } from '../lib/magazin';
interface Props { updates: CollectionEntry<'updates'>[]; meilensteine: CollectionEntry<'meilensteine'>[]; }
const { updates, meilensteine } = Astro.props;
const liste = meilensteine.map(({ data }) => data);
---
{updates.length > 0 && <aside class="ticker" aria-label="Was sich bewegt hat"><div class="in">
  <h2 class="ticker-title"><a href="/updates/">Was sich bewegt hat</a></h2>
  <ul class="items">{updates.slice(0, 4).map(({ data: u }) => { const marke = bewegung(u.meilenstein, liste); return <li><a href={`/updates/#${u.id}`}>
    <span class="meta"><time datetime={u.datum}>{datum(u.datum)}</time>{marke && <b>{marke}</b>}{u.beispiel && <span>Beispiel</span>}</span>
    <span class="headline">{title(u.titel)}</span>
  </a></li>; })}</ul>
</div></aside>}
<style>
  .ticker { background: var(--signal); color: var(--ink); }
  .in { display: grid; grid-template-columns: 1fr; gap: 0; padding-block: 16px 6px; }
  .ticker-title { font: 700 24px/1 var(--display); text-transform: uppercase; padding-bottom: 12px; }
  .ticker-title a { text-decoration: none; }
  .items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); column-gap: 28px; }
  li { border-top: 1px solid var(--ink); }
  li a { display: grid; gap: 6px; padding-block: 12px; text-decoration: none; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font: 500 11px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .meta b { font-weight: 500; background: var(--ink); color: var(--signal); padding: 3px 7px; }
  .headline { font: 500 16px/1.35 var(--body); }
  li a:hover .headline { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 900px) { .in { grid-template-columns: 220px 1fr; column-gap: 28px; padding-block: 18px; } .ticker-title { padding: 12px 0 0; } }
</style>

---
import type { Projekt } from '../lib/magazin';
import { title, stageLabels } from '../lib/magazin';
import TrlScale from './TrlScale.astro';
import ExampleNotice from './ExampleNotice.astro';
interface Props { projekt: Projekt; firma: string; ressort: string; }
const { projekt: p, firma, ressort } = Astro.props;
---
<a class="card" href={`/projekt/${p.slug}/`}>
  <div class="tag labels"><span>{ressort}</span><span>Reality Check</span></div>
  <ExampleNotice beispiel={p.beispiel} compact />
  <div><p class="company">{title(firma)}</p><h3>{title(p.name)}</h3></div>
  <TrlScale ist={p.trl_ist} behauptet={p.trl_behauptet} compact />
  <div class="value"><strong>{p.trl_ist}<small>/9</small></strong><span>{p.trl_behauptet > p.trl_ist ? `Lücke ${p.trl_behauptet - p.trl_ist}` : stageLabels[p.trl_ist]}</span></div>
  <p class="question">{p.engpass.frage} <span aria-hidden="true">→</span></p>
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 16px; min-width: 0; padding: 18px; border: 1px solid var(--ink-2); background: var(--sheet); color: var(--ink-2); text-decoration: none; }
  .card:hover, .card:focus-visible { background: var(--ink-2); color: var(--on-ink); --card-ink: var(--on-ink); --card-line: var(--ink-line); }
  .labels { display: flex; justify-content: space-between; gap: 8px; opacity: .75; }
  .company { margin-bottom: 6px; font-size: 14px; opacity: .8; }
  h3 { font: 700 30px/1 var(--display); text-transform: uppercase; }
  .value { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
  strong { font: 700 58px/.8 var(--display); }
  small { font-size: .5em; opacity: .55; }
  .value span { font: 500 12px/1.2 var(--mono); color: var(--signal-dark); text-transform: uppercase; }
  .card:hover .value span, .card:focus-visible .value span { color: var(--signal); }
  .question { display: flex; justify-content: space-between; gap: 12px; margin-top: auto; border-top: 1px solid currentColor; padding-top: 12px; font-size: 14px; }
</style>

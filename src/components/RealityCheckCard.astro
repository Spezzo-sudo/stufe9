---
// Eine Karte ist eine Geschichte: Schlagzeile, Projekt, Skala, Stand.
import type { Projekt } from '../lib/magazin';
import { title, stageLabels, datum } from '../lib/magazin';
import TrlScale from './TrlScale.astro';
interface Props { projekt: Projekt; firma: string; ressort: string; }
const { projekt: p, firma, ressort } = Astro.props;
---
<a class="card" href={`/projekt/${p.slug}/`}>
  <div class="tag labels"><span>{ressort} · Reality Check</span>{p.beispiel && <span>Beispiel</span>}</div>
  <div><h3>{p.titel}</h3><p class="project">{title(firma)} · {title(p.name)}</p></div>
  <TrlScale ist={p.trl_ist} behauptet={p.trl_behauptet} compact />
  <div class="value"><strong>{p.trl_ist}<small>/9</small></strong><span>{p.trl_behauptet > p.trl_ist ? `Lücke ${p.trl_behauptet - p.trl_ist}` : stageLabels[p.trl_ist]}</span></div>
  <p class="foot tag"><span>Stand {datum(p.stand)}</span><span aria-hidden="true">→</span></p>
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 18px; min-width: 0; padding: 20px; border: 1px solid var(--ink-2); background: var(--sheet); color: var(--ink-2); text-decoration: none; transition: background .15s, color .15s; }
  .card:hover, .card:focus-visible { background: var(--ink-2); color: var(--on-ink); --card-ink: var(--on-ink); --card-line: var(--ink-line); }
  .labels { display: flex; justify-content: space-between; gap: 8px; font-size: 10px; letter-spacing: .06em; opacity: .75; }
  h3 { font: 700 clamp(28px, 4vw, 34px)/1.02 var(--display); text-transform: uppercase; text-wrap: balance; }
  .project { margin-top: 10px; font-size: 14px; opacity: .8; }
  .value { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
  strong { font: 700 58px/.8 var(--display); }
  small { font-size: .5em; opacity: .55; }
  .value span { font: 500 12px/1.2 var(--mono); color: var(--signal-dark); text-transform: uppercase; }
  .card:hover .value span, .card:focus-visible .value span { color: var(--signal); }
  .foot { display: flex; justify-content: space-between; gap: 12px; margin-top: auto; border-top: 1px solid currentColor; padding-top: 12px; font-size: 10px; letter-spacing: .06em; }
</style>

---
import type { Projekt } from '../lib/magazin';
import Motiv from './Motiv.astro';
interface Props { projekt: Projekt; }
const { projekt: p } = Astro.props;
const fusion = p.bauart === 'tokamak' && p.engpass.einheit === 'Sekunden';
---
<figure class:list={['stage', { fusion }]} data-fusion={fusion || undefined} data-value={p.engpass.wert} data-stage={p.trl_ist}>
  <div class="stage-head"><div><p class="tag">Engpass</p><h2>{p.engpass.frage}</h2></div><div class="metric"><span class="tag">{p.engpass.kennzahl}</span><strong>{p.engpass.wert} <small>{p.engpass.einheit}</small></strong></div></div>
  <div class="scene">
    <div class="fallback"><Motiv motiv={p.bauart ? 'fusion' : p.ressorts[0]} label={p.engpass.frage} /></div>
    {fusion && <canvas aria-hidden="true"></canvas>}
  </div>
  <figcaption><p>{p.engpass.kennzahl}: {p.engpass.wert} {p.engpass.einheit}. Testziel: {p.engpass.ziel} {p.engpass.einheit}.</p><span class="tag">Schema · Zeitlich vereinfacht{p.bauart ? ` · ${p.bauart}` : ''} · {p.beispiel ? 'Beispieldaten' : 'Vereinfachte Darstellung'}</span></figcaption>
  {fusion && <button class="tag" type="button" data-motion-toggle aria-pressed="false" hidden>Animation pausieren</button>}
</figure>
<script>
  import { initFusion } from '../motive/fusion.js';
  initFusion();
</script>
<style>
  .stage { position: relative; margin: 0; border: 1px solid var(--ink-line); }
  .stage-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 16px; }
  h2 { font: 700 clamp(26px, 5vw, 46px)/.95 var(--display); text-transform: uppercase; margin-top: 6px; }
  .tag { color: var(--on-ink-muted); }
  .metric { text-align: right; margin-left: auto; }
  strong { display: block; margin-top: 4px; font: 500 clamp(24px, 4.6vw, 40px)/1.2 var(--mono); }
  strong small { font-size: .4em; }
  .scene { position: relative; height: clamp(220px, 38vw, 370px); }
  .fallback, canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas { visibility: hidden; }
  .webgl-ready canvas { visibility: visible; }
  .webgl-ready .fallback { visibility: hidden; }
  figcaption { padding: 12px 16px 16px; color: var(--on-ink-muted); display: grid; gap: 8px; font-size: 13px; }
  button { display: block; margin: 0 16px 16px; border: 1px solid var(--ink-line); background: transparent; padding: 12px; color: var(--on-ink); cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { canvas { display: none; } .webgl-ready .fallback { visibility: visible; } }
</style>

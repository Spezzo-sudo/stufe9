---
import { motivPunkte } from '../motive/umrisse';
interface Props { motiv?: string; label: string; }
const { motiv, label } = Astro.props;
const points = motivPunkte(motiv);
---
<svg viewBox="0 0 280 170" role="img" aria-label={`${label}, schematische Punktwolke`}><g fill="currentColor">{points.map((p) => <circle cx={p.x} cy={p.y} r=".8" opacity={p.opacity} />)}</g></svg>
<style>svg { display: block; width: 100%; height: 100%; color: var(--on-ink); }</style>

---
// Die Forschungsfelder als Navigation. Jede Kachel ist ein Ressort aus src/content/ressorts.
import type { CollectionEntry } from 'astro:content';
import Motiv from './Motiv.astro';
interface Props { ressorts: CollectionEntry<'ressorts'>[]; projekte: CollectionEntry<'projekte'>[]; }
const { ressorts, projekte } = Astro.props;
---
<div class="fields">{ressorts.map(({ data: r }) => {
  const count = projekte.filter(({ data: p }) => p.ressorts.includes(r.slug)).length;
  return <a class:list={['field', { planned: count === 0 }]} href={`/${r.slug}/`}>
    <div class="motif"><Motiv motiv={r.motiv} label={r.name} /></div>
    <div class="label"><h3>{r.name}</h3>{r.thema && <p class="thema">{r.thema}</p>}<p class="tag">{count === 0 ? 'In Vorbereitung' : `${count} ${count === 1 ? 'Projekt' : 'Projekte'}`}</p></div>
  </a>;
})}</div>
<style>
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--ink-line); border: 1px solid var(--ink-line); }
  @media (min-width: 720px) { .fields { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .field { display: flex; flex-direction: column; min-width: 0; background: var(--ink); color: var(--on-ink); text-decoration: none; transition: background .15s; }
  .field:hover, .field:focus-visible { background: var(--ink-2); }
  .motif { height: clamp(110px, 17vw, 170px); padding: 14px 10px 0; }
  .label { display: grid; gap: 4px; padding: 10px 14px 16px; }
  h3 { font: 700 clamp(22px, 3vw, 30px)/1 var(--display); text-transform: uppercase; }
  .thema { font-size: 13px; line-height: 1.35; color: var(--on-ink-muted); }
  .tag { margin-top: 6px; font-size: 10px; letter-spacing: .06em; color: var(--signal); }
  .planned .tag { color: var(--on-ink-muted); }
  .planned :global(svg) { opacity: .7; }
  .field:hover :global(svg), .field:focus-visible :global(svg) { opacity: 1; }
</style>

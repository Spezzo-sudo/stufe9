---
// Die Forschungsfelder als Navigation. Kacheln nur für Felder mit Inhalt, der Rest steht als Zeile darunter.
import type { CollectionEntry } from 'astro:content';
import Motiv from './Motiv.astro';
interface Props { ressorts: CollectionEntry<'ressorts'>[]; projekte: CollectionEntry<'projekte'>[]; }
const { ressorts, projekte } = Astro.props;
const anzahl = (slug: string) => projekte.filter(({ data: p }) => p.ressorts.includes(slug)).length;
const aktiv = ressorts.filter(({ data }) => anzahl(data.slug) > 0), geplant = ressorts.filter(({ data }) => anzahl(data.slug) === 0);
---
<div class="fields">{aktiv.map(({ data: r }) => { const count = anzahl(r.slug); return <a class="field" href={`/${r.slug}/`}>
  <div class="motif"><Motiv motiv={r.motiv} label={r.name} punkte={1500} /></div>
  <div class="label"><h3>{r.name}</h3>{r.thema && <p class="thema">{r.thema}</p>}<p class="tag">{count} {count === 1 ? 'Reality Check' : 'Reality Checks'}</p></div>
</a>; })}</div>
{geplant.length > 0 && <p class="planned"><span class="tag">In Vorbereitung</span>{geplant.map(({ data: r }) => <a href={`/${r.slug}/`}>{r.name}</a>)}</p>}
<style>
  .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 1px; background: var(--ink-line); border: 1px solid var(--ink-line); }
  .field { display: flex; flex-direction: column; min-width: 0; background: var(--ink); color: var(--on-ink); text-decoration: none; transition: background .15s; }
  .field:hover, .field:focus-visible { background: var(--ink-2); }
  .motif { height: clamp(120px, 20vw, 200px); padding: 14px 10px 0; }
  .label { display: grid; gap: 4px; padding: 10px 14px 16px; }
  h3 { font: 700 clamp(24px, 3.4vw, 34px)/1 var(--display); text-transform: uppercase; }
  .thema { font-size: 13px; line-height: 1.35; color: var(--on-ink-muted); }
  .tag { margin-top: 6px; font-size: 10px; letter-spacing: .06em; color: var(--signal); }
  .planned { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: baseline; margin-top: 20px; font-size: 15px; }
  .planned .tag { margin: 0; color: var(--on-ink-muted); }
  .planned a { color: var(--on-ink); text-underline-offset: 4px; text-decoration-color: var(--ink-line); }
  .planned a:hover { text-decoration-color: var(--signal); }
</style>

---
interface Props { beispiel: boolean; compact?: boolean; }
const { beispiel, compact = false } = Astro.props;
---
{beispiel && <p class:list={['example', 'tag', { compact }]}>{compact ? 'Beispiel' : 'Beispielausgabe · Alle Firmen, Projekte, Zahlen und Quellen auf dieser Seite sind frei erfunden.'}</p>}
<style>
  .example { padding: 12px max(16px, calc((100vw - var(--content-width)) / 2 + 16px)); border-block: 1px solid var(--paper-line); background: var(--sheet); color: var(--muted); }
  .compact { padding: 0; border: 0; background: transparent; color: inherit; opacity: .8; }
</style>
